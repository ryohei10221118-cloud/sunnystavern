# 複製成 .env 後再填：cp .env.example .env
#
# 你的網域，要先把 A record 指到這台伺服器的 IP。
# Caddy 會用這個網域自動申請 Let's Encrypt 憑證。
ST_DOMAIN=tavern.example.com

# 進站的帳號密碼（HTTP Basic Auth）。
# 這是你整個酒館唯一的門鎖，密碼請用長一點的隨機字串。
# 產生一組：openssl rand -base64 24
ST_USER=sunny
ST_PASSWORD=CHANGE-ME-please-use-a-long-random-string

# 容器時區
TZ=Asia/Taipei
